NODE_ENV=production
PORT=3000
BASE_URL=https://garmin.system.style
POSTGRES_DB=garmin_mcp
POSTGRES_USER=garmin
POSTGRES_PASSWORD=replace-with-32-random-bytes
DATABASE_URL=postgres://garmin:${POSTGRES_PASSWORD}@db:5432/garmin_mcp
TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
OIDC_COOKIE_KEYS=replace-with-32-random-bytes
# JSON object containing an ES256 private JWK. Run `npm run secrets` to generate all values.
OIDC_JWKS={"keys":[]}
TRUST_PROXY=1
# When false, all Garmin mutations are disabled and only garmin:read is advertised.
ENABLE_GARMIN_WRITES=false
# Enables the advanced arbitrary-path escape hatch. Leave off for public/shared deployments.
ENABLE_RAW_API=false
AUTH_WORKER_PYTHON=/opt/auth-venv/bin/python
AUTH_WORKER_PATH=/app/auth-worker/worker.py
# Comma-separated extra OAuth callback URLs for other MCP clients (optional).
EXTRA_OAUTH_REDIRECT_URIS=
# Token for the remotely-managed Cloudflare Tunnel (do not commit).
CLOUDFLARE_TUNNEL_TOKEN=
